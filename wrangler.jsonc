{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "itadz",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "itadz"
    },
    {
      "binding": "DOCUMENT_GENERATOR",
      "service": "itadz-document-generator"
    }
  ],
  "r2_buckets": [
    // Uncomment and create an R2 bucket to enable caching:
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "itadz-cache"
    // }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
